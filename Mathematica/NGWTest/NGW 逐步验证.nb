Cell["Step 6 \[CenterDot] \:56fa\:6709\:9891\:7387 29 \
\:9636\:9010\:9636\:6bd4\:5bf9\:ff08V11\:ff09+ \
\:96f6\:6a21\:6001\:6821\:6838", "Section",
 CellID->757258634,ExpressionUUID->"cdcd5f9d-5f73-dc48-a5db-4333f7f5b821"],

Cell[CellGroupData[{

Cell["\<\
ex = \"D:/AAAAAAAAAAAAAAAAAAAMyFile/Doctor/Research/ngw_final/results_doc/ngw_\
export\";
readM[f_] := Module[{d = Import[FileNameJoin[{ex, f}], \"Table\", \
\"FieldSeparators\" -> \",\"]},
   If[VectorQ[d], List /@ d, d]];
pa = Import[FileNameJoin[{ex, \"meta.json\"}], \"RawJSON\"][\"params\"];
Np = pa[\"N\"]; n2 = 2 Np;
kvec = Flatten[Table[{pa[\"k_sp\"], pa[\"k_rp\"]}, {Np}]];
Bcode = readM[\"Bbig.csv\"];
Kfull = readM[\"K_struct.csv\"] + Transpose[Bcode] . DiagonalMatrix[kvec] . \
Bcode;
Mfull = readM[\"M.csv\"];
{lam, vec} = Eigensystem[{Kfull, Mfull}];
om = Sqrt[Clip[Re[lam], {0., Infinity}]];
ord = Ordering[om];
om = om[[ord]];
fHz = om/(2. Pi);
fN = Select[fHz, # > 1. &];
fMat = Flatten[readM[\"eigfreq_matlab.csv\"]];
nm = Min[Length[fMat], Length[fN]];
rel = Abs[(fN[[1 ;; nm]] - fMat[[1 ;; nm]])/fMat[[1 ;; nm]]];
worst = SortBy[Transpose[{fN[[1 ;; nm]], rel}], -#[[2]] &][[1 ;; 3]];
worstS = StringRiffle[(\"f=\" <> ToString[N[#[[1]], 8]] <> \" Hz (rel \" <> \
ToString[N[#[[2]], 3]] <> \")\") & /@ worst, \"; \"];
mults = Sort[Tally[Round[1000. fN]][[All, 2]]];
nv = First[NullSpace[Kfull]];
iRat = 1 + pa[\"z3\"]/pa[\"z1\"];
wil = nv[[12]]/nv[[6]];
st[x_] := ToString[N[x, 6]];
Print[Column[{
   Style[\"\:5e7f\:4e49\:7279\:5f81\:503c\:95ee\:9898  K \[Phi] = \[Omega]^2 \
M \[Phi]\", Bold, 12],
   \"   K = K_struct + \[Sum] k_i B_i^T B_i    \:ff08K_struct \:6765\:81ea \
Step 3 \:6821\:6838\:8fc7\:7684csv\:ff0cB \:6765\:81ea Step 2\:ff09\",
   Row[{\"   \:6a21\:6001\:6570 = \", Length[fN], \"     MATLAB \:4fa7 = \", \
Length[fMat]}],
   Row[{\"   \:6700\:5927\:76f8\:5bf9\:8bef\:5dee = \", st[Max[rel]], \"     \
\:5e73\:5747\:76f8\:5bf9\:8bef\:5dee = \", st[Mean[rel]]}],
   Row[{\"   \:6700\:5dee 3 \:9636: \", worstS}],
   Row[{\"   f1 = f2 = \", st[fN[[1]]], \" / \", st[fN[[2]]], \" Hz     (\
\:6587\:6863\:503c 1544.833204)\"}],
   Row[{\"   f_max = \", st[fN[[-1]]], \" Hz\"}],
   \"\",
   Style[\"\:96f6\:6a21\:6001\:ff08\:6574\:6392\:521a\:4f53\:4f20\:52a8\:ff09\
\", Bold, 12],
   Row[{\"   K \:7684\:96f6\:7a7a\:95f4\:7ef4\:6570 = \", \
Length[NullSpace[Kfull]], \"      \[Omega]_min = \", st[om[[1]]], \" rad/s\"}],
   Row[{\"   \[Omega]c / \[Omega]s = \", st[wil], \"     \:7406\:8bba 1/i = \
\", st[1/iRat],
     \"     (Step 1 \:7684 Willis \:7ed3\:679c)\"}],
   Row[{\"   |K\[CenterDot]\[Phi]_null| = \", st[Norm[Kfull . nv]]}],
   \"\",
   Style[\"\:91cd\:6839\:7ed3\:6784\:ff08Step 7 \:7684\:5165\:53e3\:ff09\", \
Bold, 12],
   Row[{\"   \:591a\:91cd\:5ea6 = \", mults, \"     \[DoubleRightArrow] \
\:5171 \", Length[mults], \" \:4e2a\:9891\:7387\:7fa4\"}]}]];\
\>", "Input",
 CellID->421743788,ExpressionUUID->"335a8fda-1f02-604a-aac0-2cf3eda72ed2"],

Cell["\<\
\:5e7f\:4e49\:7279\:5f81\:503c\:95ee\:9898  K \[Phi] = \[Omega]^2 M \[Phi]
   K = K_struct + \[Sum] k_i B_i^T B_i    \:ff08K_struct \:6765\:81ea Step 3 \
\:6821\:6838\:8fc7\:7684csv\:ff0cB \:6765\:81ea Step 2\:ff09
