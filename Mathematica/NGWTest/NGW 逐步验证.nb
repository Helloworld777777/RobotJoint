Cell[CellGroupData[{

Cell["\<\
ex7 = \"D:/AAAAAAAAAAAAAAAAAAAMyFile/Doctor/Research/ngw_final/results_doc/\
ngw_export\";
rd7[f_] := Module[{d = Import[FileNameJoin[{ex7, f}], \"Table\", \
\"FieldSeparators\" -> \",\"]},
   If[VectorQ[d], List /@ d, d]];
pk7[x_] := Developer`ToPackedArray[1.0*N[x]];
f7[x_] := Module[{m = N[x], e10, mm},
   If[m == 0., Return[\"0\"]];
   e10 = Floor[N[Log[10., Abs[m]]]]; mm = m/10.^e10;
   If[Abs[mm] >= 9.9995, mm = mm/10.; e10++];
   ToString[NumberForm[mm, {4, 3}]] <> \"e\" <> ToString[e10]];

m7 = Import[FileNameJoin[{ex7, \"meta.json\"}], \"RawJSON\"];
p7 = m7[\"params\"]; r7 = m7[\"reference_run\"];
Np7 = p7[\"N\"]; fm7 = p7[\"f_mesh\"]; ws7 = p7[\"omega_s\"];
ks7 = p7[\"k_single\"]; eaE7 = p7[\"eps_a_ext\"]; eaI7 = p7[\"eps_a_int\"];
Js7 = p7[\"J_s\"]; Jp7 = p7[\"J_p\"]; Jr7 = p7[\"ring\"][\"J\"]; Jrot7 = \
p7[\"J_rotor\"];
rb17 = p7[\"rb1\"]; rb27 = p7[\"rb2\"]; rb37 = p7[\"rb3\"];
tv7 = p7[\"tv\"]; zv7 = tv7[\"zeta_v\"]; Nh7 = tv7[\"Nharm\"];
E1s7 = tv7[\"E_sn\"]; E2s7 = tv7[\"Ef_sn\"]; E1r7 = tv7[\"E_rn\"]; E2r7 = \
tv7[\"Ef_rn\"];
psi7 = tv7[\"phi_s\"]; pmi7 = tv7[\"phi_m\"]; gsr7 = tv7[\"gamma_sr\"];
Te7 = r7[\"Te\"]; cL7 = r7[\"cL\"];

M7 = pk7[rd7[\"M.csv\"]]; K7 = pk7[rd7[\"K_struct.csv\"]]; C7 = \
pk7[rd7[\"C_struct.csv\"]];
B7 = pk7[rd7[\"Bbig.csv\"]]; phA7 = pk7[rd7[\"phases.csv\"]];
T7 = pk7[Flatten[rd7[\"ref_t.csv\"]]]; Q7 = pk7[rd7[\"ref_q.csv\"]];
V7 = pk7[rd7[\"ref_v.csv\"]]; A7 = pk7[rd7[\"ref_acc.csv\"]]; Fr7 = \
pk7[rd7[\"ref_Fmesh.csv\"]];
n7 = Length[T7]; phS7 = phA7[[All, 1]]; phR7 = phA7[[All, 2]]; phE7 = \
phA7[[All, 3]];

du7[ty_] := If[ty === \"sp\", eaE7 - 1., eaI7 - 1.];
kf7[t_?NumericQ, ty_, ph_] := Module[{g, du, tau},
   du = du7[ty]; tau = fm7 t + ph; g = du;
   Do[g = g + Sin[2 Pi jj du]/(Pi jj) Cos[2 Pi jj tau]
          + (1 - Cos[2 Pi jj du])/(Pi jj) Sin[2 Pi jj tau], {jj, Nh7}];
   ks7 (1 + g)];
kd7[t_?NumericQ, ty_, ph_] := Module[{du = du7[ty], tau = fm7 t + ph, s = 0.},
   Do[s = s + 2 (-Sin[2 Pi jj du] Sin[2 Pi jj tau]
              + (1 - Cos[2 Pi jj du]) Cos[2 Pi jj tau]), {jj, Nh7}];
   ks7 fm7 s];
me7[\"sp\"] = 1/(rb17^2/(Js7 + Jrot7) + rb27^2/Jp7);
me7[\"rp\"] = 1/(rb27^2/Jp7 + rb37^2/Jr7);
cf7[t_?NumericQ, ty_, ph_] := 2 zv7 Sqrt[kf7[t, ty, ph] me7[ty]];
ef7[t_?NumericQ, ty_, pe_] := Module[{A1, A2, gg, p1, p2},
   If[ty === \"sp\", A1 = E1s7; A2 = E2s7; gg = Mod[p7[\"z1\"] pe, 2 Pi],
      A1 = E1r7; A2 = E2r7; gg = Mod[p7[\"z3\"] pe, 2 Pi] + gsr7];
   p1 = ws7 t + psi7; p2 = 2 Pi fm7 t + pmi7 + gg;
   {A1 Sin[p1] + A2 Sin[p2], A1 ws7 Cos[p1] + A2 2 Pi fm7 Cos[p2]}];
mvec7[t_?NumericQ] := Module[{kv, cv, ee, ed, dk},
   kv = Flatten[Table[{kf7[t, \"sp\", phS7[[i]]], kf7[t, \"rp\", phR7[[i]]]}, \
{i, Np7}]];
   cv = Flatten[Table[{cf7[t, \"sp\", phS7[[i]]], cf7[t, \"rp\", phR7[[i]]]}, \
{i, Np7}]];
   dk = Flatten[Table[{kd7[t, \"sp\", phS7[[i]]], kd7[t, \"rp\", phR7[[i]]]}, \
{i, Np7}]];
   ee = Flatten[Table[With[{a = ef7[t, \"sp\", phE7[[i]]], b = ef7[t, \"rp\", \
phE7[[i]]]},
        {a[[1]], b[[1]]}], {i, Np7}]];
   ed = Flatten[Table[With[{a = ef7[t, \"sp\", phE7[[i]]], b = ef7[t, \"rp\", \
phE7[[i]]]},
        {a[[2]], b[[2]]}], {i, Np7}]];
   {kv, cv, ee, ed, dk}];

(* (1) \:6fc0\:52b1\:6a21\:578b k(t)/c(t)/e(t) \:72ec\:7acb\:91cd\:7b97\:ff0c\
\:4e0e MATLAB \:7684 Fmesh \:9010\:70b9\:6bd4\:5bf9 *)
Fmm7 = Table[Module[{mv, dl}, mv = mvec7[T7[[k]]]; dl = B7 . Q7[[k]];
    mv[[1]] (dl - mv[[3]]) + mv[[2]] (B7 . V7[[k]] - mv[[4]])], {k, n7}];
errF7 = Max[Abs[Flatten[Fmm7 - Fr7]]]/Max[Abs[Flatten[Fr7]]];

(* (2) \:65b9\:7a0b\:9010\:70b9\:6b8b\:5dee\:ff1a\:52a0\:901f\:5ea6\:7528 \
MATLAB \:5bfc\:51fa\:7684\:89e3\:6790\:503c\:ff0c\:4e0d\:505a\:6570\:503c\
\:5fae\:5206 *)
e66 = 1.0 UnitVector[30, 6]; e127 = 1.0 UnitVector[30, 12];
Fext7 = Table[Te7 e66 - cL7 V7[[k, 12]] e127, {k, n7}];
Mqdd = Table[M7 . A7[[k]], {k, n7}];
Kq = Table[K7 . Q7[[k]], {k, n7}];
Cv = Table[C7 . V7[[k]], {k, n7}];
BtF = Table[Transpose[B7] . Fmm7[[k]], {k, n7}];
res7 = Mqdd + Kq + Cv + BtF - Fext7;
sc1 = Max[Abs[Flatten[Mqdd]]]; sc2 = Max[Abs[Flatten[Kq]]];
sc3 = Max[Abs[Flatten[Cv]]]; sc4 = Max[Abs[Flatten[BtF]]];
sc5 = Max[Abs[Flatten[Fext7]]];
rDof7 = Max /@ Transpose[Abs[res7]];
rat7 = Quiet[V7[[2 ;; , 12]]/V7[[2 ;; , 6]]];
iR7 = p7[\"i_ratio\"];

Print[Column[{
   Style[\"V15 \[CenterDot] \:52a8\:529b\:5b66\:65f6\:7a0b\:9a8c\:8bc1\:ff08\
\:72ec\:7acb\:7ec4\:88c5\:8fd0\:52a8\:65b9\:7a0b \[RightArrow] \:9010\:70b9\
\:6b8b\:5dee\:ff09\", Bold, 13],
   Row[{\"  \:2460 \:6fc0\:52b1\:6a21\:578b\:72ec\:7acb\:91cd\:7b97   max|\
\[CapitalDelta]F| / max|F| = \", f7[errF7], \"     [\:5224\:636e < 1e-6]\"}],
   Row[{\"     max|F| = \", f7[Max[Abs[Flatten[Fr7]]]], \" N\"}],
   \"\",
   Row[{\"  \:2461 \:65b9\:7a0b\:6b8b\:5dee / max|M q\:0308|   = \", \
f7[Max[Abs[Flatten[res7]]]/sc1],
     \"     [\:5224\:636e < 1e-8]\"}],
   Row[{\"     \:65b9\:7a0b\:6b8b\:5dee / max|K q|    = \", \
f7[Max[Abs[Flatten[res7]]]/sc2]}],
   Row[{\"     \:65b9\:7a0b\:6b8b\:5dee / max|F_ext|  = \", \
f7[Max[Abs[Flatten[res7]]]/sc5]}],
   Row[{\"     \:5404\:9879\:91cf\:7ea7 : |M q\:0308| = \", f7[sc1], \" N ,  \
|K q| = \", f7[sc2],
     \" N ,  |B\:1d40F| = \", f7[sc4], \" N ,  |C q\:0307| = \", f7[sc3], \" \
N ,  |F_ext| = \", f7[sc5], \" N\"}],
   \"\",
   Row[{\"  \:2462 \:9010\:81ea\:7531\:5ea6\:6b8b\:5dee : \:4e0a\:754c \", \
f7[Max[rDof7]], \" (DOF \",
     ToString[First@Ordering[rDof7, -1]], \")    \:4e0b\:754c \", \
f7[Min[rDof7]]}],
   Row[{\"     \[Omega]c/\[Omega]s \:672b\:503c = \", f7[rat7[[-1]]], \"   \
(Willis 1/i = \", f7[1/iR7], \")\",
     \"    t>0.05s \:6700\:5927\:504f\:5dee = \", f7[Max[Abs[rat7[[500 ;; ]] \
- 1/iR7]]]}]
   }]];\
\>", "Input",
 CellLabel->"In[1]:=",
 CellID->636842791,ExpressionUUID->"1570ff18-b33b-e348-b639-0224793703ac"],

