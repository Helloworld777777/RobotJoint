Cell["\<\
Step 8 \[CenterDot] \:80fd\:91cf\:5e73\:8861\:4e0e C \:77e9\:9635\:72ec\:7acb\
\:91cd\:6784\:ff08V16\:ff09\[LongDash] \:542b\:65f6\:53d8\:521a\:5ea6\:6ce8\
\:5165\:9879 + \:5bf9\:7167\:5b9e\:9a8c
\
\>", "Section",
 CellID->1818510133,ExpressionUUID->"b17b4602-34cb-5043-b113-e1c8ea195d3f"],

Cell[CellGroupData[{

Cell["\<\
(* (A) C \:77e9\:9635\:4ece\:7269\:7406\:91cf\:72ec\:7acb\:91cd\:5efa\:ff1a\
beta \:7531 WL \:81ea\:5df1\:7684\:5e7f\:4e49\:7279\:5f81\:503c\:7b97\:51fa\
\:ff0c\:4e0d\:8bfb meta *)
km8[\"sp\"] = ks7 (1 + (eaE7 - 1.)); km8[\"rp\"] = ks7 (1 + (eaI7 - 1.));
Kmesh8 = pk7[Total[Table[km8[\"sp\"] Outer[Times, B7[[2 i - 1]], B7[[2 i - 1]]]
      + km8[\"rp\"] Outer[Times, B7[[2 i]], B7[[2 i]]], {i, Np7}]]];
Ktot8 = pk7[K7 + Kmesh8];
eg8 = Eigensystem[{Ktot8, M7}];
ord8 = Ordering[eg8[[1]]];
ev8 = eg8[[1, ord8]]; vec8 = eg8[[2, ord8]];
sel8 = Select[Range[Length[ev8]], ev8[[#]] > 1. &];
om8 = Sqrt[ev8[[sel8]]]; vec8 = vec8[[sel8]];
nMode8 = Length[om8]; w18 = om8[[1]];
zetaB8 = p7[\"damp\"][\"zeta_b\"];
beta8 = 2. zetaB8/w18;
errC8 = Norm[C7 - beta8 K7, \"Frobenius\"]/Norm[C7, \"Frobenius\"];
cm8[\"sp\"] = 2 zv7 Sqrt[km8[\"sp\"] me7[\"sp\"]];
cm8[\"rp\"] = 2 zv7 Sqrt[km8[\"rp\"] me7[\"rp\"]];
Cmesh8 = pk7[Total[Table[cm8[\"sp\"] Outer[Times, B7[[2 i - 1]], B7[[2 i - 1]]]
      + cm8[\"rp\"] Outer[Times, B7[[2 i]], B7[[2 i]]], {i, Np7}]]];
Ctot8 = pk7[C7 + Cmesh8];
zeta8[phi_, w_] := (phi . (Ctot8 . phi))/(2. w (phi . (M7 . phi)));
kMid8 = Quotient[nMode8, 2];

(* (B) \:80fd\:91cf\:5e73\:8861\:ff1aE = 1/2 v'Mv + 1/2 q'Kq + 1/2 \
\[CapitalSigma] k(d-e)^2 *)
tab8 = Table[Module[{mv, kv, cv, ee, ed, dk, dl, dld, Ek, Ev, Em, dEdt,
    Pe, Pc, Pm, PiE, PiK},
   mv = mvec7[T7[[k]]];
   kv = mv[[1]]; cv = mv[[2]]; ee = mv[[3]]; ed = mv[[4]]; dk = mv[[5]];
   dl = B7 . Q7[[k]]; dld = B7 . V7[[k]];
   Ek = 0.5 V7[[k]] . (M7 . V7[[k]]);
   Ev = 0.5 Q7[[k]] . (K7 . Q7[[k]]);
   Em = 0.5 Total[kv (dl - ee)^2];
   dEdt = V7[[k]] . (M7 . A7[[k]]) + V7[[k]] . (K7 . Q7[[k]])
      + Total[kv (dl - ee) (dld - ed)] + 0.5 Total[dk (dl - ee)^2];
   Pe = V7[[k]] . Fext7[[k]];
   Pc = -V7[[k]] . (C7 . V7[[k]]);
   Pm = -Total[cv dld (dld - ed)];
   PiE = -Total[kv (dl - ee) ed];
   PiK = 0.5 Total[dk (dl - ee)^2];
   {Ek + Ev + Em, dEdt, Pe, Pc, Pm, PiE, PiK,
    dEdt - (Pe + Pc + Pm + PiE + PiK), dEdt - (Pe + Pc + Pm)}], {k, n7}];
tab8 = pk7[tab8];
col8[j_] := tab8[[All, j]];
resF8 = col8[8]; resN8 = col8[9];
scDE8 = Max[Abs[col8[2]]];
h8 = T7[[2]] - T7[[1]];
trap8[c_] := h8 (Total[c] - 0.5 (First[c] + Last[c]));
E0v = First[col8[1]]; E1v = Last[col8[1]];

Print[Column[{
   Style[\"(A) C \:77e9\:9635\:4ece\:7269\:7406\:91cf\:91cd\:5efa\", Bold, 12],
   Row[{\"   f1 = \", f7[w18/(2 Pi)], \" Hz     beta = 2\[Zeta]b/\[Omega]1 = \
\", f7[beta8], \" s\"}],
   Row[{\"   ||C_rebuild - C_struct||/||C_struct|| = \", f7[errC8], \"     [\
\:5224\:636e < 1e-12]\"}],
   Row[{\"   \:6a21\:6001\:963b\:5c3c\:6bd4 : \[Zeta](f1) = \", \
f7[zeta8[vec8[[1]], om8[[1]]]],
     \"   \[Zeta](f_mid) = \", f7[zeta8[vec8[[kMid8]], om8[[kMid8]]]],
     \"   \[Zeta](fmax) = \", f7[zeta8[vec8[[nMode8]], om8[[nMode8]]]]}],
   \"\",
   Style[\"(B) \:80fd\:91cf\:5e73\:8861\:ff08\:5b8c\:6574\:9879\:ff09\", \
Bold, 12],
   Row[{\"   |dE/dt| = \", f7[scDE8], \" W     max|resid| = \", \
f7[Max[Abs[resF8]]], \" W\"}],
   Row[{\"   max|resid| / max|dE/dt| = \", f7[Max[Abs[resF8]]/scDE8], \"     \
[\:5224\:636e < 1e-8]\"}],
   Row[{\"   E(t=0) = \", f7[E0v], \" J     E(t_end) = \", f7[E1v], \" J\"}],
   \"\",
   Style[\"(C) \:5bf9\:7167\:5b9e\:9a8c\:ff1a\:53bb\:6389\:4e24\:4e2a\:6ce8\
\:5165\:9879\", Bold, 12],
   Row[{\"   \:4fdd\:7559\:6ce8\:5165\:9879 = \", f7[Max[Abs[resF8]]/scDE8],
     \"     \:53bb\:6389\:6ce8\:5165\:9879 = \", f7[Max[Abs[resN8]]/scDE8],
     \"     \:653e\:5927 \", f7[Max[Abs[resN8]]/Max[Abs[resF8]], \" \
\:500d\"]}],
   \"\",
   Style[\"(D) \:529f\:7387\:79ef\:5206\:ff08\:68af\:5f62\:ff09\", Bold, 12],
   Row[{\"   \[Integral]P_ext = \", f7[trap8[col8[3]]], \" J    \
\[Integral]P_C = \", f7[trap8[col8[4]]],
     \" J    \[Integral]P_mesh = \", f7[trap8[col8[5]]], \" J\"}],
   Row[{\"   \[Integral]P_inj_e = \", f7[trap8[col8[6]]], \" J    \
\[Integral]P_inj_k = \", f7[trap8[col8[7]]], \" J\"}],
   Row[{\"   \[Integral]dE/dt = \", f7[trap8[col8[2]]], \" J    E(t_end)-E(0) \
= \", f7[E1v - E0v],
     \" J    \:95ed\:5408\:8bef\:5dee = \", f7[Abs[trap8[col8[2]] - (E1v - \
E0v)]/Abs[E1v - E0v]]}],
   Row[{\"   \:603b\:8017\:6563 = \", f7[trap8[col8[4]] + trap8[col8[5]]], \" \
J   (\:5e94\:4e3a\:8d1f)\"}]
   }]];\
\>", "Input",
 CellLabel->"In[52]:=",
 CellID->1015271328,ExpressionUUID->"4f685c76-6e4d-f841-b622-3838be5828d6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"(A) C \:77e9\:9635\:4ece\:7269\:7406\:91cf\:91cd\:5efa\"\>",
      StripOnInput->False,
      FontSize->12,
      FontWeight->Bold]},
