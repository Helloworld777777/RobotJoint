Cell[CellGroupData[{

Cell["Step 2 \[CenterDot] \:556e\:5408\:51e0\:4f55\:4e0e B \:77e9\:9635\:72ec\
\:7acb\:91cd\:63a8\:ff08V3 + V4\:ff09", "Section",
 CellID->279579483,ExpressionUUID->"16664372-192a-6642-85b5-31811a7e9206"],

Cell[CellGroupData[{

Cell["\<\
ex = \"D:/AAAAAAAAAAAAAAAAAAAMyFile/Doctor/Research/ngw_final/results_doc/ngw_\
export\";
readM[f_] := Module[{d = Import[FileNameJoin[{ex, f}], \"Table\", \
\"FieldSeparators\" -> \",\"]},
   If[VectorQ[d], List /@ d, d]];
pa = Import[FileNameJoin[{ex, \"meta.json\"}], \"RawJSON\"][\"params\"];
al = pa[\"alpha\"]; r1 = pa[\"r1\"]; r2 = pa[\"r2\"]; Np = pa[\"N\"];
Bcode = readM[\"Bbig.csv\"]; phC = readM[\"phases.csv\"];
er[ph_] := {Cos[ph], Sin[ph], 0.}; et[ph_] := {-Sin[ph], Cos[ph], 0.};
nn[ph_] := Cos[al] et[ph] + Sin[al] er[ph];
qs = Table[Symbol[\"qs\" <> ToString[k]], {k, 6}];
qp = Table[Symbol[\"qp\" <> ToString[k]], {k, 6}];
uOf[b_] := b[[1 ;; 3]]; thOf[b_] := b[[4 ;; 6]];
uP[b_, r_] := uOf[b] + Cross[thOf[b], r];
deltaSP[i_] := Module[{ph = 2. Pi (i - 1)/Np, rA, rB},
   rA = r1 er[ph]; rB = -r2 er[ph]; nn[ph] . (uP[qp, rB] - uP[qs, rA])];
deltaRP[i_] := Module[{ph = 2. Pi (i - 1)/Np, rC}, rC = r2 er[ph]; nn[ph] . \
uP[qp, rC]];
place[g_, i_] := Module[{row = ConstantArray[0., 30], c0 = 12 + 6 (i - 1)},
   row[[1 ;; 6]] = g[[1 ;; 6]]; row[[c0 + 1 ;; c0 + 6]] = g[[7 ;; 12]]; row];
res = Table[Module[{bs = Bcode[[2 i - 1]], br = Bcode[[2 i]], gs, gr},
    gs = place[Grad[deltaSP[i], Join[qs, qp]], i];
    gr = place[Grad[deltaRP[i], Join[qs, qp]], i];
    {i, Norm[bs - gs], Norm[bs + gs], Norm[br - gr], Norm[br + gr]}], {i, Np}];
phMM = Table[{(i - 1)/Np, (i - 1)/Np + 1/2, 2 Pi (i - 1)/Np}, {i, Np}];
errPh = Max[Abs[N[phMM - phC]]];
rb1 = pa[\"rb1\"]; rb2 = pa[\"rb2\"];
st[x_] := ToString[N[x, 4]];
Print[Column[Join[
   {Style[\"\[Delta]sp = n\[CenterDot][(u_p + \[Theta]_p\[Times]r_p) - (u_s + \
\[Theta]_s\[Times]r_s)] ,  B = \[PartialD]\[Delta]/\[PartialD]q (Grad)\", \
Bold, 12],
    Row[{\"   i     |Bsp-\[Del]\[Delta]|      |Bsp+\[Del]\[Delta]|      |Brp-\
\[Del]\[Delta]|      |Brp+\[Del]\[Delta]|\"}],
    Sequence @@ Table[Row[{\"   \", res[[k, 1]], \"      \", st[res[[k, 2]]], \
\"           \",
        st[res[[k, 3]]], \"            \", st[res[[k, 4]]], \"            \", \
st[res[[k, 5]]]}], {k, Length[res]}],
    \"\",
    Row[{\"\[DoubleRightArrow] \:5916\:556e\:5408 B_sp = -\[Del]\[Delta]sp  (\
\:6b8b\:5dee \", st[res[[1, 3]]], \")   \:5185\:556e\:5408 B_rp = +\[Del]\
\[Delta]rp  (\:6b8b\:5dee \", st[res[[1, 4]]], \")\"}],
    \"\",
    Style[\"\:89e3\:6790\:6052\:7b49\:5f0f\:6821\:6838\:ff1a|Bsp| = Sqrt[2 + \
rb1^2 + rb2^2]\:ff0c|Brp| = Sqrt[1 + rb2^2]\", Bold, 12],
    Row[{\"   |Bsp| = \", st[Norm[Bcode[[1]]]], \"   vs   \", st[Sqrt[2 + \
rb1^2 + rb2^2]]}],
    Row[{\"   |Brp| = \", st[Norm[Bcode[[2]]]], \"   vs   \", st[Sqrt[1 + \
rb2^2]]}],
    \"\",
    Row[{\"V3 \:76f8\:4f4d\:8868 max|\[Phi]MM - \[Phi]code| = \", \
st[errPh]}]}]]];\
\>", "Input",
 CellLabel->"In[234]:=",
 CellID->1366493896,ExpressionUUID->"eed373d1-cc24-4e49-a106-fdb4616abe2b"],

