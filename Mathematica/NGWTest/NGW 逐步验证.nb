Cell[CellGroupData[{

Cell["Step 1 \[CenterDot] \:8fd0\:52a8\:5b66\:95ed\:5f0f\:89e3\:ff08Willis \
\:65b9\:7a0b\:ff09\[LongDash] V1", "Section",
 CellID->926149930,ExpressionUUID->"9e51be3b-5649-0345-9e1d-abe4f9f40ed6"],

Cell[CellGroupData[{

Cell["\<\
ClearAll[ws, wc, wp, zs, zp, zr, n];
willis = (ws - wc) zs + (0 - wc) zr == 0;
iExpr = Simplify[ws/wc /. Solve[willis, ws][[1]]];
wpSol = Simplify[wp /. Solve[(wp - wc) zp == -(ws - wc) zs, wp][[1]]];
rS = Simplify[wpSol/ws /. ws -> iExpr wc];
rC = Simplify[wpSol/wc /. ws -> iExpr wc];
cong = zr -> zs + 2 zp;
num = {zs -> 24, zp -> 18, zr -> 60};
fmExpr = Simplify[(n/60) zs (1 - 1/iExpr)];
Print[Column[{
   Style[\"Willis \:65b9\:7a0b\:ff08\:5185\:9f7f\:5708\:56fa\:5b9a \[Omega]r \
= 0\:ff09\", Bold, 12],
   Row[{\"i = \[Omega]s/\[Omega]c = \", iExpr}],
   Row[{\"\[Omega]p/\[Omega]s = \", rS, \"   \[RightArrow]   \", Simplify[rS \
/. cong], \"   (\:7528\:540c\:5fc3\:6761\:4ef6)\"}],
   Row[{\"\[Omega]p/\[Omega]c = \", rC, \"   \[RightArrow]   \", Simplify[rC \
/. cong]}],
   \"\",
   Row[{\"\:4ee3\:5165 zs=24, zp=18, zr=60 :  i = \", N[iExpr /. num, 10],
     \" ,  \[Omega]p/\[Omega]s = \", N[Simplify[rS /. cong] /. num, 10], \" , \
 \[Omega]p/\[Omega]c = \",
     N[Simplify[rC /. cong] /. num, 10]}],
   Row[{\"NGW_test \:671f\:671b :  i = 3.5 ,  \[Omega]p/\[Omega]s = \
-0.66666667\"}],
   \"\",
   Row[{\"f_mesh = (n/60)\[CenterDot]zs\[CenterDot](1-1/i) = \", fmExpr}],
   Row[{\"n = 500  r/min \[RightArrow] \", fmExpr /. num /. n -> 500, \" = \",
     N[fmExpr /. num /. n -> 500, 10], \" Hz\"}],
   Row[{\"n = 1500 r/min \[RightArrow] \", N[fmExpr /. num /. n -> 1500, 10], \
\" Hz  (\:65e7\:57fa\:7ebf 428.5714)\"}]}]];\
\>", "Input",
 CellLabel->"In[145]:=",
 CellID->1650021772,ExpressionUUID->"ab7b1fa1-b620-ac44-a355-f4575fdfbfc1"],

