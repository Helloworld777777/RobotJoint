Cell[CellGroupData[{

Cell["\<\
ex = \"D:/AAAAAAAAAAAAAAAAAAAMyFile/Doctor/Research/ngw_final/results_doc/ngw_\
export\";
readM[f_] := Module[{d = Import[FileNameJoin[{ex, f}], \"Table\", \
\"FieldSeparators\" -> \",\"]},
   If[VectorQ[d], List /@ d, d]];
pa = Import[FileNameJoin[{ex, \"meta.json\"}], \"RawJSON\"][\"params\"];
Np = pa[\"N\"];
al2 = pa[\"alpha\"]; r1v = pa[\"r1\"]; r2v = pa[\"r2\"];
er2[ph_] := {Cos[ph], Sin[ph], 0.}; et2[ph_] := {-Sin[ph], Cos[ph], 0.};
nn2[ph_] := Cos[al2] et2[ph] + Sin[al2] er2[ph];
qa = Table[Symbol[\"qa\" <> ToString[k]], {k, 6}];
qb = Table[Symbol[\"qb\" <> ToString[k]], {k, 6}];
up2[b_, r_] := b[[1 ;; 3]] + Cross[b[[4 ;; 6]], r];
dSP[i_] := Module[{ph = 2. Pi (i - 1)/Np}, nn2[ph] . (up2[qb, -r2v er2[ph]] - \
up2[qa, r1v er2[ph]])];
dRP[i_] := Module[{ph = 2. Pi (i - 1)/Np}, nn2[ph] . up2[qb, r2v er2[ph]]];
plc[g_, i_] := Module[{row = ConstantArray[0., 30], c0 = 12 + 6 (i - 1)},
   row[[1 ;; 6]] = g[[1 ;; 6]]; row[[c0 + 1 ;; c0 + 6]] = g[[7 ;; 12]]; row];
Bm = Table[If[OddQ[j], plc[Grad[dSP[(j + 1)/2], Join[qa, qb]], (j + 1)/2],
    plc[Grad[dRP[j/2], Join[qa, qb]], j/2]], {j, 2 Np}];
n2 = 2 Np;
vars30b = Table[Symbol[\"zz\" <> ToString[k]], {k, 30}];
kvec = Flatten[Table[{pa[\"k_sp\"], pa[\"k_rp\"]}, {Np}]];
delSym = Bm . vars30b;
Umesh = 1/2 Total[kvec delSym^2];
KmeshB = Transpose[Bm] . DiagonalMatrix[kvec] . Bm;
errHess = Norm[N[D[Umesh, {vars30b, 2}]] - KmeshB]/Norm[KmeshB];
qt = N[Table[Sin[k]/7., {k, 30}]];
errSign = Norm[N[D[Umesh, {vars30b, 1}] /. Thread[vars30b -> qt]] - \
Transpose[Bm] . (kvec (Bm . qt))]/
   Norm[Transpose[Bm] . (kvec (Bm . qt))];
Kall = readM[\"K_struct.csv\"] + KmeshB;
Kpinv = PseudoInverse[Kall];
iRat = 1 + pa[\"z3\"]/pa[\"z1\"];
mkF[te_, tl_] := ReplacePart[ConstantArray[0., 30], {6 -> te, 12 -> -tl}];
resOf[te_, tl_] := Module[{F = mkF[te, tl], q = Kpinv . mkF[te, tl]}, \
Norm[Kall . q - F]/Norm[F]];
Te = 20.; TL = iRat Te;
qst = Kpinv . mkF[Te, TL];
Bcode = readM[\"Bbig.csv\"];
(* \:51e0\:4f55\:7ea6\:5b9a vs \:4ee3\:7801\:7ea6\:5b9a *)
sgSp = Sign[Total[Bm[[1]] Bcode[[1]]]]; sgRp = Sign[Total[Bm[[2]] Bcode[[2]]]];
dcod = Bcode . qst;
Fsp = kvec[[1 ;; n2 ;; 2]] dcod[[1 ;; n2 ;; 2]];
Frp = kvec[[2 ;; n2 ;; 2]] dcod[[2 ;; n2 ;; 2]];
Fth = Te/(3 pa[\"rb1\"]);
KHeb = Max[Abs[Fsp]]/Mean[Abs[Fsp]];
st[x_] := ToString[N[x, 6]];
Print[Column[{
   Style[\"(a) \:7b26\:53f7\:4e00\:81f4\:6027\:ff1aU = 1/2 \[Sum] k_i \
\[Delta]_i^2 , \[Delta] = B q , F = k \[CircleDot] \[Delta]\", Bold, 12],
   Row[{\"   rel |\[PartialD]^2U/\[PartialD]q^2 - \[Sum] k_i B_i^T B_i| = \", \
st[errHess]}],
   Row[{\"   rel |\[Del]U - B^T F|  (\:5728\:6d4b\:8bd5\:70b9 q \:5904\:6c42\
\:503c)      = \", st[errSign]}],
   \"   \[DoubleRightArrow] \:5f39\:6027\:5e7f\:4e49\:529b = -\[Del]U = -B^T \
F\:ff0cS-Function \:4e2d -Bbig'*Fmesh \:7684\:7b26\:53f7\:6b63\:786e\",
   \"\",
   Style[\"(b) \:4e24\:5957\:7ea6\:5b9a\:7684\:5173\:7cfb\:ff08Step 2 \:7684\
\:53d1\:73b0\:7684\:5177\:4f53\:540e\:679c\:ff09\", Bold, 12],
   Row[{\"   sign(\[Sum] B_geo\[CenterDot]B_code) \:5916\:556e\:5408 = \", \
sgSp, \"    \:5185\:556e\:5408 = \", sgRp}],
   \"   \[DoubleRightArrow] \:5916\:556e\:5408 B_geo = -B_code \:ff0c\:6545 \
\[Delta]_geo = -\[Delta]_code \
\:ff1b\:529b\:5fc5\:987b\:7528\:4ee3\:7801\:7ea6\:5b9a\:6c47\:62a5\",
   \"\",
   Style[\"(c) \:9759\:529b\:5747\:8f7d   Te = 20 N\[CenterDot]m , TL = i Te \
= 70 N\[CenterDot]m\", Bold, 12],
   Row[{\"   F_sp (\:4ee3\:7801\:7ea6\:5b9a) = \", st[Fsp], \" N\"}],
   Row[{\"   \:7406\:8bba Te/(3 r_b1) = \", st[Fth], \" N      (NGW_test \
\:671f\:671b 295.604937)\"}],
   Row[{\"   F_rp (\:4ee3\:7801\:7ea6\:5b9a) = \", st[Frp], \" N\"}],
   Row[{\"   F_rp + F_sp      = \", st[Frp + Fsp], \"      \
(\:884c\:661f\:8f6e\:529b\:5e73\:8861\:ff0c\:5e94\:4e3a 0)\"}],
   Row[{\"   \:5747\:8f7d\:7cfb\:6570 K_H = max|F_sp| / mean|F_sp| = \", \
st[KHeb]}],
   \"\",
   Style[\"(d) \:53ef\:89e3\:6027\:ff1a\:53ea\:6709 TL = i Te \:624d\:5b58\
\:5728\:9759\:529b\:89e3\:ff08\:521a\:4f53\:865a\:529f\:7684\:7b49\:4ef7\:8868\
\:8ff0\:ff09\", Bold, 12],
   Row[{\"   TL =  i Te          \:6b8b\:5dee = \", st[resOf[Te, iRat Te]]}],
   Row[{\"   TL = 1.5 Te         \:6b8b\:5dee = \", st[resOf[Te, 1.5 Te]]}],
   Row[{\"   TL = -i Te          \:6b8b\:5dee = \", st[resOf[Te, -iRat \
Te]]}]}]];\
\>", "Input",
 CellID->1509694309,ExpressionUUID->"09a745f0-0c93-744b-ae50-4f94d9fcaf5e"],

