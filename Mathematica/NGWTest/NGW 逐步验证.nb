Cell[CellGroupData[{

Cell["Step 3 \[CenterDot] \:7ed3\:6784\:521a\:5ea6 K_struct \
\:72ec\:7acb\:91cd\:63a8\:ff08V5\:ff09\[LongDash] \:5e94\:53d8\:80fd + \
Hessian", "Section",
 CellID->1580218635,ExpressionUUID->"a58b3376-587e-004d-b402-9e63a8ed0be7"],

Cell[CellGroupData[{

Cell["\<\
Xss = Table[Symbol[\"xs\" <> ToString[k]], {k, 6}];
Xcc = Table[Symbol[\"xc\" <> ToString[k]], {k, 6}];
Xpp[i_] := Table[Symbol[\"xp\" <> ToString[i] <> \"q\" <> ToString[k]], {k, \
6}];
vars30 = Join[Xss, Xcc, Sequence @@ Table[Xpp[i], {i, Np}]];
Xof[X_, r_] := Join[X[[1 ;; 3]] + Cross[X[[4 ;; 6]], r], X[[4 ;; 6]]];
ez = {0., 0., 1.};
rrOf[i_] := {Cos[2. Pi (i - 1)/Np], Sin[2. Pi (i - 1)/Np], 0.};
ks = pa[\"k_sun_bearing\"]; kc = pa[\"k_carrier_bearing\"];
kp = pa[\"k_planet_bearing\"]; kt = pa[\"k_tilt_bearing\"];
aa = pa[\"a\"]; bb = pa[\"b\"];
Kb = DiagonalMatrix[{kp, kp, kp, kt, kt, 0.}];
Usun = 1/2 ks (Xss[[1 ;; 3]] . Xss[[1 ;; 3]]) + 1/2 kt (Xss[[4]]^2 + \
Xss[[5]]^2);
Ucar = 1/2 kc (Xcc[[1 ;; 3]] . Xcc[[1 ;; 3]]) + 1/2 kt (Xcc[[4]]^2 + \
Xcc[[5]]^2);
Ucen = Sum[Module[{d = Xof[Xpp[i], {0., 0., 0.}] - Xof[Xcc, aa rrOf[i]]}, 1/2 \
d . Kb . d], {i, Np}];
Kcen = N[D[Usun + Ucar + Ucen, {vars30, 2}]];
Kcode = readM[\"K_struct.csv\"];
errK = Norm[Kcen - Kcode]/Norm[Kcode];
nsK = Chop[NullSpace[Kcen], 10^-8];
supp[v_] := Sort[Select[Range[Length[v]], Abs[N[v[[#]]]] > 1.*^-9 &]];
dofNames = Join[{\"xs\", \"xc\"}, Table[\"xp\" <> ToString[i], {i, Np}]];
nameOf[j_] := dofNames[[Quotient[j - 1, 6] + 1]] <> \".\" <> {\"x\", \"y\", \
\"z\", \"Tx\", \"Ty\", \"Tz\"}[[Mod[j - 1, 6] + 1]];
bsym = Symbol[\"bOffset\"];
UpairSym = Sum[Sum[Module[{d = Xof[Xpp[i], sg bsym/2 ez] - Xof[Xcc, aa \
rrOf[i] + sg bsym/2 ez]},
     1/2 d . Kb . d], {sg, {-1., 1.}}], {i, Np}];
limRes = Norm[N[D[UpairSym, {vars30, 2}] /. bsym -> 0.] - 2 N[D[Ucen, \
{vars30, 2}]]];
st[x_] := ToString[N[x, 4]];
Print[Column[{
   Style[\"X(r) = [u + \[Theta]\[Times]r ; \[Theta]] ,  \[CapitalDelta]i = \
X_p(0) - X_c(a e_r) ,  K = \[PartialD]^2U/\[PartialD]q^2\", Bold, 12],
   Row[{\"   K_struct \:76f8\:5bf9\:8bef\:5dee = \", st[errK]}],
   Row[{\"   \:5bf9\:79f0\:6027 = \", st[Norm[Kcen - Transpose[Kcen]]], \"    \
\:79e9 = \", MatrixRank[Kcen],
     \"    \:96f6\:7a7a\:95f4\:7ef4\:6570 = \", Length[nsK]}],
   \"\",
   Style[\"\:96f6\:7a7a\:95f4\:65b9\:5411\:ff08K_struct \:5355\:72ec\:65f6\
\:65e0\:521a\:5ea6\:7684\:8fd0\:52a8\:ff09\", Bold, 12],
   Sequence @@ Table[Row[{\"   \", k, \": \", StringRiffle[nameOf /@ \
supp[nsK[[k]]], \", \"]}], {k, Length[nsK]}],
   \"\",
   Style[\"layout \:81ea\:6d3d\:6027\", Bold, 12],
   Row[{\"   b\[Rule]0 \:65f6  \[DoubleVerticalBar]K_pair - 2 K_center\
\[DoubleVerticalBar] = \", st[limRes]}]}]];\
\>", "Input",
 CellLabel->"In[254]:=",
 CellID->1553214992,ExpressionUUID->"796a9b82-cb55-5543-a451-a02c8ee72b71"],

