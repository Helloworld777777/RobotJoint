Cell[CellGroupData[{

Cell["Step 4 \[CenterDot] \:8d28\:91cf\:77e9\:9635 M \:72ec\:7acb\:91cd\:63a8\
\:ff08V6\:ff09\[LongDash] \:60ef\:91cf\:94fe + \:52a8\:80fd Hessian + \:8f6c\
\:5b50\:5e76\:5165", "Section",
 CellID->533079922,ExpressionUUID->"8893c91e-ed1f-0245-8f12-cc0218b72897"],

Cell[CellGroupData[{

Cell["\<\
rho = pa[\"rho\"]; bw = pa[\"b\"]; r1s = pa[\"r1\"]; r2s = pa[\"r2\"];
Jdisk[ro_, ri_] := 1/2 rho Pi bw (ro^4 - ri^4);
mdisk[ro_, ri_] := rho Pi bw (ro^2 - ri^2);
JsMM = Jdisk[r1s, pa[\"d_sun_bore\"]/2]; msMM = mdisk[r1s, \
pa[\"d_sun_bore\"]/2];
JpMM = Jdisk[r2s, pa[\"d_pl_bore\"]/2]; mpMM = mdisk[r2s, pa[\"d_pl_bore\"]/2];
rpin = pa[\"d_pin\"]/2; Lpin = pa[\"L_pin\"];
mpinMM = rho Pi rpin^2 Lpin;
JpinxxMM = mpinMM (3 rpin^2 + Lpin^2)/12;
JplateMM = 1/2 rho Pi pa[\"t_plate\"] (pa[\"R_plate\"]^4 - pa[\"R_hub\"]^4);
mplateMM = rho Pi pa[\"t_plate\"] (pa[\"R_plate\"]^2 - pa[\"R_hub\"]^2);
JpinsMM = pa[\"N\"] mpinMM (pa[\"a\"]^2 + rpin^2/2);
Jc1MM = JplateMM + JpinsMM;
mc1MM = mplateMM + pa[\"N\"] mpinMM;
sumSin2 = Total[(Sin[2. Pi (# - 1)/pa[\"N\"]])^2 & /@ Range[pa[\"N\"]]];
Jc1xxMM = JplateMM/2 + pa[\"N\"] JpinxxMM + sumSin2 mpinMM pa[\"a\"]^2;
pnames = {\"J_s\", \"m_s\", \"J_p\", \"m_p\", \"m_pin\", \"J_pin_xx\", \
\"J_plate\", \"m_plate\", \"J_c1\", \"m_c1\", \"J_c1_xx\"};
mmVals = {JsMM, msMM, JpMM, mpMM, mpinMM, JpinxxMM, JplateMM, mplateMM, \
Jc1MM, mc1MM, Jc1xxMM};
relP = Abs[(mmVals - (pa /@ pnames))/(pa /@ pnames)];
wi = First@Ordering[relP, -1];
rotS = Symbol[\"JrotorSym\"];
Tgen[X_, m_, Jxx_, Jzz_] := 1/2 m (X[[1]]^2 + X[[2]]^2 + X[[3]]^2) + 1/2 (Jxx \
X[[4]]^2 + Jxx X[[5]]^2 + Jzz X[[6]]^2);
Ttot = Tgen[Xss, msMM, JsMM/2, JsMM + rotS] + Tgen[Xcc, mc1MM, Jc1xxMM, \
Jc1MM] +
   Sum[Tgen[Xpp[i], mpMM, JpMM/2, JpMM], {i, Np}];
Msym = D[Ttot, {vars30, 2}];
M0 = N[Msym /. rotS -> 0.];
Mcode = readM[\"M.csv\"];
errM = Norm[M0 - Mcode]/Norm[Mcode];
offDiag = Max[Abs[M0 - DiagonalMatrix[Diagonal[M0]]]];
expDiag = Join[{msMM, msMM, msMM, JsMM/2, JsMM/2, JsMM},
   {mc1MM, mc1MM, mc1MM, Jc1xxMM, Jc1xxMM, Jc1MM},
   Sequence @@ Table[{mpMM, mpMM, mpMM, JpMM/2, JpMM/2, JpMM}, {Np}]];
errDiag = Max[Abs[(Diagonal[M0] - expDiag)/expDiag]];
diffRot = N[Msym /. rotS -> 2.7*^-3] - M0;
nzRot = Position[diffRot, x_ /; Abs[x] > 1.*^-15];
st[x_] := ToString[N[x, 4]];
Print[Column[{
   Style[\"(a) \:60ef\:91cf\:94fe\:ff1a\:51e0\:4f55 + \
\:5e73\:884c\:8f74\:5b9a\:7406\", Bold, 12],
   Row[{\"   11 \:4e2a\:60ef\:91cf/\:8d28\:91cf\:53c2\:6570\:6700\:5927\:76f8\
\:5bf9\:8bef\:5dee = \", st[Max[relP]], \"   (\:6700\:5dee\:9879 \", \
pnames[[wi]], \")\"}],
   Row[{\"   \[CapitalSigma] sin^2\[Phi]i = \", st[sumSin2], \"   (\:5e73\
\:884c\:8f74\:9879\:7cfb\:6570\:ff0c\:7406\:8bba 3/2)\"}],
   \"\",
   Style[\"(b) T = \[Sum] 1/2 m|u'|^2 + 1/2(Jxx\[Theta]x'^2 + Jxx\[Theta]y'^2 \
+ Jzz\[Theta]z'^2) ,  M = \[PartialD]^2T/\[PartialD]q'^2\", Bold, 12],
   Row[{\"   M \:76f8\:5bf9\:8bef\:5dee = \", st[errM], \"    \:975e\:5bf9\
\:89d2\:5143\:6700\:5927 = \", st[offDiag]}],
   Row[{\"   \:5bf9\:89d2\:5143\:6a21\:5f0f\:6838\:5bf9\:ff08\:6bcf\:4ef6 \
[m,m,m,Jxx,Jxx,Jzz]\:ff09\:6700\:5927\:76f8\:5bf9\:8bef\:5dee = \", \
st[errDiag]}],
   \"\",
   Style[\"(c) \
\:7535\:673a\:8f6c\:5b50\:60ef\:91cf\:5e76\:5165\:4f4d\:7f6e\", Bold, 12],
   Row[{\"   M(J_rotor) - M(0) \:7684\:975e\:96f6\:4f4d\:7f6e = \", nzRot, \" \
    \:503c = \", st[diffRot[[6, 6]]]}],
   Row[{\"   \:5bf9\:5e94\:81ea\:7531\:5ea6 = \", nameOf[6], \" (\:592a\:9633\
\:8f6e\:7ed5 z \:8f74)\"}]}]];\
\>", "Input",
