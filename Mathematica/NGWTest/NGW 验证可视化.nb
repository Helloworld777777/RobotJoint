Cell[CellGroupData[{

Cell["\<\
t = Flatten[readM[\"ref_t.csv\"]];
Fm = readM[\"ref_Fmesh.csv\"];
spCols = {1, 3, 5}; rpCols = {2, 4, 6};
Print[Row[{\"\:91c7\:6837\:70b9 = \", Length[t], \"    dt = \", t[[2]] - \
t[[1]], \" s    t_end = \", t[[-1]], \" s\"}]];
Print[Row[{\"\:672b\:65f6\:523b F_sp = \", NumberForm[Fm[[-1, spCols]], 6], \
\" N\"}]];
Print[Row[{\"\:672b\:65f6\:523b F_rp = \", NumberForm[Fm[[-1, rpCols]], 6], \
\" N\"}]];
ListLinePlot[
  Join[Table[Transpose[{t, Fm[[All, i]]}], {i, spCols}],
       Table[Transpose[{t, Fm[[All, i]]}], {i, rpCols}]],
  PlotStyle -> Join[
    Table[Directive[Thickness[0.0045], ColorData[97][k]], {k, 1, 3}],
    Table[Directive[Thickness[0.0035], Dashed, ColorData[97][k]], {k, 1, 3}]],
  PlotLegends -> LineLegend[{\"F_sp 1\", \"F_sp 2\", \"F_sp 3\", \"F_rp 1\", \
\"F_rp 2\", \"F_rp 3\"},
    LegendLayout -> {\"Row\", 3}],
  Frame -> True,
  FrameLabel -> {{\"\:556e\:5408\:529b  [N]\", \"\"}, {\"t  [s]\", \"\"}},
  PlotLabel -> \"\:4e09\:8def\:556e\:5408\:529b\:65f6\:7a0b\:ff08Te = 2 N\
\[CenterDot]m \:5e38\:503c\:ff0cTL = 0.5\[CenterDot]\[Omega]c\:ff09\\n\:7406\
\:8bba\:9759\:6001\:503c F = Te / (3 r_b1) = 29.5605 N\",
  GridLines -> {None, {-29.5605, 29.5605}},
  GridLinesStyle -> Directive[RGBColor[0.85, 0.5, 0.2], Dashed],
  BaseStyle -> {FontSize -> 12},
  ImageSize -> 780]\
\>", "Input",
