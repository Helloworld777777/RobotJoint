Cell[CellGroupData[{

Cell["1 \[CenterDot] \:56fa\:6709\:9891\:7387\:8c31\:ff08\:5e7f\:4e49\:7279\
\:5f81\:503c K \[CurlyPhi] = \[Omega]\.b2 M \[CurlyPhi]\:ff09", "Section",
 CellID->318255067,ExpressionUUID->"9f2565cf-faf5-0b4c-882c-6dc90f5f7d94"],

Cell[CellGroupData[{

Cell["\<\
ex = \"D:/AAAAAAAAAAAAAAAAAAAMyFile/Doctor/Research/ngw_final/results_doc/ngw_\
export\";
readM[f_] := Module[{d = Import[FileNameJoin[{ex, f}], \"Table\", \
\"FieldSeparators\" -> \",\"]},
   If[VectorQ[d], List /@ d, d]];
Ktot = readM[\"K_struct.csv\"] + readM[\"K_mesh_avg.csv\"];
Mmat = readM[\"M.csv\"];
lam = Chop[Eigenvalues[{Ktot, Mmat}]];
fMM = Sort@Select[Sqrt@Clip[Re[lam], {0., Infinity}], # > 1. &]/(2. Pi);
keys = Round[1000. fMM];
cnt = Counts[keys];
cols = Lookup[cnt, keys];
styled = MapThread[
   Style[#1, Directive[PointSize[0.014],
      If[#2 > 1, RGBColor[0.85, 0.20, 0.15], RGBColor[0.20, 0.35, 0.75]]]] &,
   {fMM, cols}];
Print[Row[{\"\:6a21\:6001\:6570 = \", Length[fMM], \"     \:6700\:4f4e\:4e24\
\:9636 = \",
    NumberForm[fMM[[1]], 12], \" / \", NumberForm[fMM[[2]], 12], \" Hz\"}]];
ListPlot[styled,
  Filling -> Axis,
  FillingStyle -> Directive[Opacity[0.30], GrayLevel[0.45]],
  Frame -> True,
  FrameLabel -> {{\"\:56fa\:6709\:9891\:7387  f  [Hz]\", \"\"}, {\"\:6a21\
\:6001\:5e8f\:53f7\", \"\"}},
  PlotLabel -> \"NGW 30-DOF \:56fa\:6709\:9891\:7387\:ff0829 \:9636\:975e\
\:96f6\:6a21\:6001\:ff09\\n\:7ea2 = \:91cd\:6839\:ff0c\:84dd = \:5355\:6839\",
  GridLines -> {None, Table[k 2000, {k, 1, 11}]},
  GridLinesStyle -> Directive[LightGray, Dashed],
  BaseStyle -> {FontSize -> 12},
  ImageSize -> 780]\
\>", "Input",
 CellID->1266599809,ExpressionUUID->"9db5f777-acb0-d04b-adf9-68e20091abfe"],

