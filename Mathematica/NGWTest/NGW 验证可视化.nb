Cell[CellGroupData[{

Cell["3 \[CenterDot] \:9891\:8c31\:ff1a\:556e\:9891\:53ca\:5176\:8c10\:6ce2\
\:3001\:8fb9\:9891", "Section",
 CellID->1427354298,ExpressionUUID->"e96b9be1-274f-c84d-b7f8-612e40c19ed7"],

Cell[CellGroupData[{

Cell["\<\
dt = t[[2]] - t[[1]];
fsr = 1./dt;
x = Fm[[All, 1]] - Mean[Fm[[All, 1]]];
nx = Length[x];
nz = 8 nx;
X = Abs[Fourier[PadRight[x, nz]]] 2./nx;
nf = Floor[nz/2];
fr = Table[(k - 1.)/(nz dt), {k, 1, nf}];
amp = X[[1 ;; nf]];
locmax = Select[Range[2, nf - 1], amp[[#]] > amp[[# - 1]] && amp[[#]] > \
amp[[# + 1]] &];
top = TakeLargestBy[locmax, amp[[#]] &, 6];
pk = SortBy[Table[{fr[[k]], amp[[k]]}, {k, top}], First];
Print[Row[{\"\:91c7\:6837\:7387 = \", fsr, \" Hz   \:9891\:7387\:5206\:8fa8\
\:7387 = \", 1./(nx dt), \" Hz\"}]];
Print[Row[{\"\:68c0\:51fa\:4e3b\:5cf0 [Hz] = \", NumberForm[pk[[All, 1]], \
6]}]];
Print[Row[{\"\:7406\:8bba: f_mesh = 142.857, 2f = 285.714, 3f = 428.571, 4f = \
571.429, 5f = 714.286\"}]];
fmesh = 142.85714285714286; fs1 = 8.333333333333334;
ListLinePlot[Transpose[{fr, amp}],
  PlotRange -> {{0, 800}, All},
  Frame -> True,
  FrameLabel -> {{\"\:5e45\:503c   |F_sp 1|  [N]\", \"\"}, {\"\:9891\:7387  \
[Hz]\", \"\"}},
  PlotLabel -> \"\:5916\:556e\:5408\:556e\:5408\:529b\:9891\:8c31\:ff08\:96f6\
\:586b\:5145 8\[Times]\:ff09\\n\:6a59\:8272\:865a\:7ebf = \:556e\:9891\:8c10\
\:6ce2 k\[CenterDot]f_mesh\:ff1b\:7070\:8272\:70b9\:7ebf = \:8fb9\:9891 \
f_mesh \[PlusMinus] f_s\",
  GridLines -> {
    Table[k fmesh, {k, 1, 5}],
    None},
  GridLinesStyle -> Directive[RGBColor[0.9, 0.55, 0.1], Dashed],
  Epilog -> {
    GrayLevel[0.45], Dashing[{0.01, 0.01}],
    InfiniteLine[{{fmesh - fs1, 0}, {fmesh - fs1, 1}}],
    InfiniteLine[{{fmesh + fs1, 0}, {fmesh + fs1, 1}}]},
  BaseStyle -> {FontSize -> 12},
  ImageSize -> 780]\
\>", "Input",
 CellID->424775254,ExpressionUUID->"bfebb66d-96ec-9945-886c-d4e419424059"],

